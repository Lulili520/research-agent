# Local research inputs and generated task artifacts
/research/
research/**/sources/*
research/**/downloads/*

# Disposable local verification output
.tmp-*/
tmp/

# Python bytecode
__pycache__/
*.py[cod]

# Keep directory placeholders and source manifests if added
!research/**/sources/.gitkeep
!research/**/sources/manifest.md

# Local environments and test tooling
.venv/
.venvs/
.pytest_cache/
.coverage

# Local recursive-improvement version library (immutable snapshots and evaluations)
/.rsi-history/
